#include <winres.h>
#include "../src/win/resource.h"
// Icon comes from res/icon.ico (see scripts/update-icon.*).
IDI_APP ICON "icon.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NeusByCast"
      VALUE "FileDescription", "Cast Recorder"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Cast Recorder"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "CastRecorder.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
