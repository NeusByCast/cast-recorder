#include <winres.h>
#include "../src/win/resource.h"
#include "../src/win/version.h"
// Icon comes from res/icon.ico (see scripts/update-icon.*).
IDI_APP ICON "icon.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION CR_VERSION_MAJOR,CR_VERSION_MINOR,CR_VERSION_PATCH,0
 PRODUCTVERSION CR_VERSION_MAJOR,CR_VERSION_MINOR,CR_VERSION_PATCH,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NeusByCast"
      VALUE "FileDescription", "Cast Recorder"
      VALUE "FileVersion", CR_VERSION_STR
      VALUE "ProductName", "Cast Recorder"
      VALUE "ProductVersion", CR_VERSION_STR
      VALUE "OriginalFilename", "CastRecorder.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
// Procedural tones (scripts/make-sounds.py): start chime, stop chime, pause/resume tick.
IDR_SND_START WAVE "sounds/start.wav"
IDR_SND_STOP WAVE "sounds/stop.wav"
IDR_SND_TICK WAVE "sounds/tick.wav"
